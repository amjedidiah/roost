  "narrative": {
    "northStar": "The Night Shelf",
    "overview": "A quiet shelf of your own papers, read at night: one dark column, white type, and a single yellow mark on the next thing you must do. Plain words on every control so anyone can use it on a phone. It refuses the chat thread, the busy dashboard and the cute bird theme.",
    "keyCharacteristics": [
      "Near-black ground, off-white text, one grey for everything secondary.",
      "One self-hosted grotesk (Schibsted Grotesk) in two weights.",
      "Soft-cornered cards on the ground; no shadows.",
      "Highlighter yellow on the next upcoming line only.",
      "Urgency shown by a square mark plus a word, never colour alone."
    ],
    "rules": [
      {
        "name": "The One Line Rule",
        "body": "Yellow marks only the next thing to do: the first upcoming item, or the to-do in an answer.",
        "section": "colors"
      },
      {
        "name": "The Words First Rule",
        "body": "Colour never carries meaning alone: lateness, urgency and errors are always words too.",
        "section": "colors"
      },
      {
        "name": "No Tabular Figures",
        "body": "Schibsted's tnum widens . and , so figures stay proportional.",
        "section": "typography"
      },
      {
        "name": "The Two Weights Rule",
        "body": "Only 400 and 700; emphasis is weight or size.",
        "section": "typography"
      },
      {
        "name": "The Three Grounds Rule",
        "body": "Night is the page, card is a thing, raised is a part of a thing. Never a card on a card.",
